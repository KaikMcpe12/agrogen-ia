# Copie para .env e preencha antes de rodar
# Nunca commitar o .env no repositório

POSTGRES_DB=agrogen
POSTGRES_USER=agrogen
POSTGRES_PASSWORD=troque_por_senha_forte

# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_secret_aleatorio

ENVIRONMENT=production

# Auth estática entre o backend e o microsserviço de IA (mesmo valor nos dois).
# Vazio = microsserviço de IA não exige autenticação.
# Gerar com: python -c "import secrets; print(secrets.token_hex(24))"
BACKEND_AUTH_SECRET=

# Timeout (ms) das chamadas de inferência ao microsserviço de IA
IA_SERVICE_TIMEOUT_MS=800
