# Copie para .env.local para rodar `npm run dev` consumindo a API real.
# Sem VITE_USE_REAL_API=true, o app usa mocks em memória (sem backend).

# Desliga os mocks e consome o backend real
VITE_USE_REAL_API=true

# baseURL do axios. Padrão /api/v1 (roteado pelo proxy de dev / Nginx em produção)
VITE_API_URL=/api/v1

# Alvo do proxy de dev (Vite) para /api/v1. Padrão http://localhost (Nginx do Docker).
# VITE_DEV_API_PROXY=http://localhost
