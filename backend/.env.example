# Banco de dados (postgres:// ou postgresql:// são reescritos automaticamente para asyncpg)
DATABASE_URL=postgresql://user:password@localhost:5432/agrogen

# Segredo para assinar JWT (mínimo 32 caracteres, gerado com: openssl rand -hex 32)
SECRET_KEY=troque-por-um-valor-secreto-longo-aqui

# development | production
ENVIRONMENT=development

# Origens permitidas pelo CORS (lista JSON)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Duração dos tokens (horas / dias)
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7
